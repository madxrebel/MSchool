rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Landing-page demo requests: the public site may only CREATE a well-formed
    // inquiry. Nobody can read, list, update or delete from the client.
    // Read leads from the Firebase console or the Admin SDK (which bypasses rules).
    match /schoolInquiries/{inquiryId} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['name', 'schoolName', 'phone', 'studentCount', 'notes', 'createdAt', 'source'])
                    && request.resource.data.keys().hasAll(['name', 'schoolName', 'phone'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
                    && request.resource.data.schoolName is string
                    && request.resource.data.schoolName.size() > 0 && request.resource.data.schoolName.size() <= 160
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() >= 7 && request.resource.data.phone.size() <= 20
                    && (!('studentCount' in request.resource.data)
                        || (request.resource.data.studentCount is string && request.resource.data.studentCount.size() <= 60))
                    && (!('notes' in request.resource.data)
                        || (request.resource.data.notes is string && request.resource.data.notes.size() <= 1000))
                    && (!('createdAt' in request.resource.data)
                        || (request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40))
                    && (!('source' in request.resource.data)
                        || (request.resource.data.source is string && request.resource.data.source.size() <= 80));
      allow read, update, delete: if false;
    }

    // Collections below are not used by this site. Closed until a feature needs them.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
